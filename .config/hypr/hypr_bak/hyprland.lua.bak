-- Définition des variables
local mod = "SUPER"
local terminal = "wezterm"
local fileManager = "yazi-gui"
local menu = "rofi -show run"

-- Lancement au démarrage (Autostart)
hl.on("hyprland.start", function()
  hl.exec_cmd("quickshell")
  hl.exec_cmd("awww-daemon")
  hl.exec_cmd("hyprctl setcursor Adwaita 20")
  hl.exec_cmd("dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP")
  hl.exec_cmd("hypridle")
  hl.exec_cmd("touch /tmp/qs_vol")
  hl.exec_cmd("QML_XHR_ALLOW_FILE_READ=1 quickshell -p ~/.config/quickshell/mon_theme/shell.qml")
  hl.exec_cmd("sddm")
  hl.exec_cmd("snappy-switcher --daemon")
end)

hl.config({
  env = {
    "MOZ_ENABLE_WAYLAND,1",
    "XCURSOR_SIZE,24",
    "HYPRCURSOR_SIZE,24",
    "LANG,fr_FR.UTF-8"
  },
  general = {
    gaps_in = 5,
    gaps_out = 5,
    border_size = 1,
    col = {
      active_border = "rgba(e8833aff)", -- Simplifié en couleur unie
      inactive_border = "rgba(414868aa)"
    },
    resize_on_border = false,
    allow_tearing = false,
    layout = "dwindle"
  },
  decoration = {
    rounding = 18,
    rounding_power = 2,
    active_opacity = 1.0,
    inactive_opacity = 1.0,
    shadow = {
      enabled = true,
      range = 10,
      render_power = 3,
      color = "rgba(1a1a1aee)"
    },
    blur = {
      enabled = true,
      size = 8,
      passes = 3,
      ignore_opacity = true,
      new_optimizations = true
    }
  },
  animations = {
    enabled = true,
    bezier = {
      "snappy, 0.20, 1.00, 0.30, 1.00",
      "smooth, 0.45, 0.00, 0.15, 1.00",
      "bounce, 0.34, 1.56, 0.64, 1.00",
      "linear, 0.00, 0.00, 1.00, 1.00",
      "overshoot, 0.05, 0.90, 0.10, 1.05"
    },
    animation = {
      "windows, 1, 3, bounce, popin 85%",
      "windowsIn, 1, 3, bounce, popin 85%",
      "windowsOut, 1, 3, snappy, popin 90%",
      "windowsMove, 1, 4, snappy",
      "fade, 1, 3, smooth",
      "fadeIn, 1, 3, smooth",
      "fadeOut, 1, 2, smooth",
      "fadeSwitch, 1, 3, smooth",
      "fadeShadow, 1, 3, smooth",
      "fadeDim, 1, 3, smooth",
      "border, 1, 4, smooth",
      "borderangle, 1, 30, linear, loop",
      "workspaces, 1, 4, overshoot, slide",
      "specialWorkspace, 1, 4, overshoot, slidevert",
      "layers, 1, 3, smooth, slide",
      "layersIn, 1, 3, bounce, slide",
      "layersOut, 1, 2, snappy, slide"
    }
  },
  master = {
    new_status = "master"
  },
  misc = {
    force_default_wallpaper = -1,
    disable_hyprland_logo = false
  },
  input = {
    kb_layout = "fr",
    follow_mouse = 1,
    sensitivity = 0,
    touchpad = {
      natural_scroll = true
    }
  },
  --gestures = {
  -- workspace_swipe = true
  --},
  --device = {
  --  name = "epic-mouse-v1",
  --    sensitivity = -0.5
  --  },
  xwayland = {
    force_zero_scaling = true
  },
  -- Traduction des windowrules et layerrules en syntaxe V2 unifiée
  windowrulev2 = {
    "suppress_event maximize, class:.*",
    "no_focus, class:^$, title:^$, xwayland:1, float:1, fullscreen:0, pin:0",
    "float, class:^(hyprland-run)$",
    "move 20 monitor_h-120, class:^(hyprland-run)$",
    "opacity 0.85 0.85, class:^(thunar)$",
    "opacity 0.85 0.80, class:^(deezer-desktop)$",
    "opacity 0.90 0.80, class:^(obsidian)$",
    "opacity 0.95 0.90, class:^(discord)$",
    "opacity 0.8 0.75, class:^(wezterm)$",
    "noblur 0, class:^(firefox)$"
  },
  layerrule = {
    "blur, waybar",
    "ignorealpha 0.5, waybar",
    "blur, ^(quickshell)$",
    "ignorealpha 0.5, ^(quickshell)$"
  }
})

-- Applications et Système
hl.bind(mod .. " + W", hl.dsp.exec_cmd("~/.config/hypr/scripts/wallpaper-picker.sh"))
hl.bind(mod .. " + RETURN", hl.dsp.exec_cmd(terminal))
hl.bind(mod .. " + C", hl.dsp.window.kill())
hl.bind(mod .. " + M",
  hl.dsp.exec_cmd("command -v hyprshutdown >/dev/null 2>&1 && hyprshutdown || hyprctl dispatch exit"))
hl.bind(mod .. " + E", hl.dsp.exec_cmd(fileManager))
-- hl.bind(mod .. " + V", hl.dsp.window.togglefloating())
hl.bind(mod .. " + R", hl.dsp.exec_cmd(menu))
hl.bind(mod .. " + P", hl.dsp.exec_cmd("pseudo"))
hl.bind(mod .. " + J", hl.dsp.exec_cmd("layoutmsg togglesplit"))
hl.bind(mod .. " + F", hl.dsp.window.fullscreen(1))
hl.bind(mod .. " SHIFT + F", hl.dsp.window.fullscreen(0))

-- Alt+Tab
hl.bind("ALT + Tab", hl.dsp.exec_cmd("snappy-switcher next"))
hl.bind("ALT SHIFT + Tab", hl.dsp.exec_cmd("snappy-switcher prev"))

-- Captures d'écran
hl.bind("Print", hl.dsp.exec_cmd('grim -g "$(slurp)" - | wl-copy'))
hl.bind("SHIFT + Print", hl.dsp.exec_cmd('grim ~/Pictures/$(date +%Y-%m-%d_%Hh%Mm%Ss_grim.png)'))
hl.bind(mod .. " + Print", hl.dsp.exec_cmd('grim -g "$(slurp)" ~/Pictures/$(date +%Y-%m-%d_%Hh%Mm%Ss_grim.png)'))

-- Déplacement du focus
hl.bind(mod .. " + left", hl.dsp.focus({ direction = "l" }))
hl.bind(mod .. " + right", hl.dsp.focus({ direction = "r" }))
hl.bind(mod .. " + up", hl.dsp.focus({ direction = "u" }))
hl.bind(mod .. " + down", hl.dsp.focus({ direction = "d" }))

-- Navigation Espaces de travail (AZERTY)
hl.bind(mod .. " + ampersand", hl.dsp.focus({ workspace = "1" }))
hl.bind(mod .. " + eacute", hl.dsp.focus({ workspace = "2" }))
hl.bind(mod .. " + quotedbl", hl.dsp.focus({ workspace = "3" }))
hl.bind(mod .. " + apostrophe", hl.dsp.focus({ workspace = "4" }))
hl.bind(mod .. " + parenleft", hl.dsp.focus({ workspace = "5" }))
hl.bind(mod .. " + minus", hl.dsp.focus({ workspace = "6" }))
hl.bind(mod .. " + egrave", hl.dsp.focus({ workspace = "7" }))
hl.bind(mod .. " + underscore", hl.dsp.focus({ workspace = "8" }))
hl.bind(mod .. " + ccedilla", hl.dsp.focus({ workspace = "9" }))
hl.bind(mod .. " + agrave", hl.dsp.focus({ workspace = "10" }))

-- Déplacement des fenêtres vers un Espace de travail
hl.bind(mod .. " + SHIFT + ampersand", hl.dsp.exec_cmd("hyprctl dispatch movetoworkspace 1"))
hl.bind(mod .. " + SHIFT + eacute", hl.dsp.exec_cmd("hyprctl dispatch movetoworkspace 2"))
hl.bind(mod .. " + SHIFT + quotedbl", hl.dsp.exec_cmd("hyprctl dispatch movetoworkspace 3"))
hl.bind(mod .. " + SHIFT + apostrophe", hl.dsp.exec_cmd("hyprctl dispatch movetoworkspace 4"))
-- Et ainsi de suite pour les autres touches de 5 à 10...

-- N'oublie pas le Scratchpad :
hl.bind(mod .. " + SHIFT + S", hl.dsp.exec_cmd("hyprctl dispatch movetoworkspace special:magic"))
-- Molette de souris pour les espaces de travail
hl.bind(mod .. " + mouse_down", hl.dsp.focus({ workspace = "e+1" }))
hl.bind(mod .. " + mouse_up", hl.dsp.focus({ workspace = "e-1" }))

-- Redimensionnement et déplacement à la souris (bindm)
hl.bind(mod .. " + mouse:272", hl.dsp.exec_cmd("movewindow"), { mouse = true })
hl.bind(mod .. " + mouse:273", hl.dsp.exec_cmd("resizewindow"), { mouse = true })

-- Contrôles Multimédia (Volume & Luminosité) - Intégration Quickshell incluse
hl.bind("XF86AudioRaiseVolume",
  hl.dsp.exec_cmd(
    "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+ && wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print int($2 * 100)}' > /tmp/qs_vol"))
hl.bind("XF86AudioLowerVolume",
  hl.dsp.exec_cmd(
    "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print int($2 * 100)}' > /tmp/qs_vol"))
hl.bind("XF86AudioMute",
  hl.dsp.exec_cmd(
    "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle && wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{if ($3 == \"[MUTED]\") print 0; else print int($2 * 100)}' > /tmp/qs_vol"))

hl.bind("XF86MonBrightnessUp", hl.dsp.exec_cmd("brightnessctl -e4 -n2 set 5%+"))
hl.bind("XF86MonBrightnessDown", hl.dsp.exec_cmd("brightnessctl -e4 -n2 set 5%-"))

-- Contrôles Lecture (Playerctl)
hl.bind("XF86AudioNext", hl.dsp.exec_cmd("playerctl next"))
hl.bind("XF86AudioPause", hl.dsp.exec_cmd("playerctl play-pause"))
hl.bind("XF86AudioPlay", hl.dsp.exec_cmd("playerctl play-pause"))
hl.bind("XF86AudioPrev", hl.dsp.exec_cmd("playerctl previous"))
