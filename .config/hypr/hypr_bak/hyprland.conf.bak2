


################
### MONITORS ###
################

# See https://wiki.hypr.land/Configuring/Monitors/
#monitor=,preferred,auto,auto
#monitor = HDMI-A-1, preferred, auto, 1, transform, 1
#monitor = DP-3,2560x1440@280.00,auto,auto 
###################
### MY PROGRAMS ###
###################

# See https://wiki.hypr.land/Configuring/Keywords/

# Set programs that you use
$terminal = wezterm
$fileManager = yazi-gui
$menu = qs ipc call launcher toggle
$EDITOR = nvim


#################
### AUTOSTART ###
#################

# Autostart necessary processes (like notifications daemons, status bars, etc.)
# Or execute your favorite apps at launch like this:

# exec-once = $terminal
# exec-once = nm-applet --indicator & blueman-applet
exec-once = quickshell
exec-once = awww-daemon

exec-once = hyprctl setcursor Adwaita 20

exec-once = dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec-once = hypridle

exec-once = touch /tmp/qs_vol

exec-once = QML_XHR_ALLOW_FILE_READ=1 quickshell -p ~/.config/quickshell/mon_theme/shell.qml

exec-once = sddm

#Alt + tab
exec-once = snappy-switcher --daemon 




#############################
### ENVIRONMENT VARIABLES ###
#############################

# See https://wiki.hypr.land/Configuring/Environment-variables/
env = MOZ_ENABLE_WAYLAND,1
env = XCURSOR_SIZE,24
env = HYPRCURSOR_SIZE,24

env = LANG,fr_FR.UTF-8

