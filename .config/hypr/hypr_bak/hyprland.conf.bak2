#####################
### LOOK AND FEEL ###
#####################

# Refer to https://wiki.hypr.land/Configuring/Variables/

# https://wiki.hypr.land/Configuring/Variables/#general
general {
    gaps_in = 5
    gaps_out = 5  

    border_size = 1

    # https://wiki.hypr.land/Configuring/Variables/#variable-types for info about colors
    col.active_border = rgba(e8833aff) rgba(ff9d52ff) rgba(ffc94dff) 45deg
    col.inactive_border = rgba(414868aa)

    # Set to true enable resizing windows by clicking and dragging on borders and gaps
    resize_on_border = false

    # Please see https://wiki.hypr.land/Configuring/Tearing/ before you turn this on
    allow_tearing = false

    layout = dwindle
}

# https://wiki.hypr.land/Configuring/Variables/#decoration
decoration {
    rounding = 18
    rounding_power = 2

    # Change transparency of focused and unfocused windows
    active_opacity = 1.0
    inactive_opacity = 1.0

    shadow {
        enabled = true
        range = 4
        render_power = 3
        color = rgba(1a1a1aee)
    }

    # https://wiki.hypr.land/Configuring/Variables/#blur
        


    blur {
        enabled = true
        size = 8         # Taille du rayon de flou
        passes = 3       # Nombre de passes (plus il y en a, plus c'est fluide mais gourmand en ressources)
        ignore_opacity = true
        new_optimizations = true
    }
    
    shadow{

      enabled = true
      range = 10
      render_power = 3
      color = rgba(1a1a1aee)


    }

    
}

# https://wiki.hypr.land/Configuring/Variables/#animations

animations {
    enabled = yes

    # ── Bezier curves (courbes d'easing) ──
    # Snappy : démarrage rapide, fin douce → sensation "premium"
    bezier = snappy,        0.20, 1.00, 0.30, 1.00
    # Smooth : transitions élégantes pour workspaces
    bezier = smooth,        0.45, 0.00, 0.15, 1.00
    # Bounce : léger rebond pour ouverture de fenêtre
    bezier = bounce,        0.34, 1.56, 0.64, 1.00
    # Linear : pour fades simples
    bezier = linear,        0.00, 0.00, 1.00, 1.00
    # Overshoot : effet "spring" subtil
    bezier = overshoot,     0.05, 0.90, 0.10, 1.05

    # ── Fenêtres (ouverture/fermeture) ──
    animation = windows,        1, 3, bounce,    popin 85%
    animation = windowsIn,      1, 3, bounce,    popin 85%
    animation = windowsOut,     1, 3, snappy,    popin 90%
    animation = windowsMove,    1, 4, snappy

    # ── Fades (opacité) ──
    animation = fade,           1, 3, smooth
    animation = fadeIn,         1, 3, smooth
    animation = fadeOut,        1, 2, smooth
    animation = fadeSwitch,     1, 3, smooth
    animation = fadeShadow,     1, 3, smooth
    animation = fadeDim,        1, 3, smooth

    # ── Bordures ──
    animation = border,         1, 4, smooth
    animation = borderangle,    1, 30, linear, loop

    # ── Workspaces (le plus visible) ──
    animation = workspaces,     1, 4, overshoot, slide
    animation = specialWorkspace, 1, 4, overshoot, slidevert

    # ── Layers (bar, notifs, rofi) ──
    animation = layers,         1, 3, smooth, slide
    animation = layersIn,       1, 3, bounce, slide
    animation = layersOut,      1, 2, snappy, slide
}


# Ref https://wiki.hypr.land/Configuring/Workspace-Rules/
